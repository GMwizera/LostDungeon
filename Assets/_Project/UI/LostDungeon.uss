/*
   Abyssal Crypt design system (from the Google Stitch designs in stitch_lost_dungeon_crawler).
   Void black surfaces, square corners, 1px razor borders, luminous accents:
   gold #f59e0b = loot and main actions, cyan #38bdf8 = weather and agility,
   red #ef4444 = health and danger, jade #10b981 = completion.
*/

/* ---------- Base ---------- */

.screen {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(0, 0, 0);
}

Label {
    color: rgb(244, 244, 245);
}

.panel {
    padding: 20px 22px;
    background-color: rgb(10, 10, 10);
    border-width: 1px;
    border-color: rgb(31, 31, 31);
    border-radius: 0;
}

.panel--raised {
    background-color: rgb(18, 18, 18);
}

.title {
    font-size: 40px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(244, 244, 245);
    white-space: normal;
}

.heading {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(244, 244, 245);
}

.eyebrow {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2.5px;
    color: rgb(245, 158, 11);
}

.mono {
    font-size: 13px;
    letter-spacing: 1.5px;
    color: rgb(113, 113, 122);
}

.body {
    font-size: 15px;
    color: rgb(212, 212, 216);
    white-space: normal;
}

.muted {
    color: rgb(113, 113, 122);
}

.row {
    flex-direction: row;
    align-items: center;
}

.spacer {
    flex-grow: 1;
}

.divider {
    height: 1px;
    margin: 12px 0;
    background-color: rgb(31, 31, 31);
}

.icon {
    width: 22px;
    height: 22px;
    -unity-background-scale-mode: scale-to-fit;
}

.icon--lg {
    width: 34px;
    height: 34px;
}

/* ---------- Buttons ---------- */

Button {
    height: 48px;
    margin: 5px 0;
    padding: 0 16px;
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-left;
    color: rgb(244, 244, 245);
    background-color: rgb(0, 0, 0);
    border-width: 1px;
    border-color: rgb(39, 39, 42);
    border-radius: 0;
    transition-duration: 0.08s;
}

Button:hover {
    border-color: rgb(56, 189, 248);
}

Button:active {
    background-color: rgb(18, 18, 18);
}

Button:disabled {
    opacity: 0.35;
}

.btn-primary {
    color: rgb(245, 158, 11);
    background-color: rgb(10, 10, 10);
    border-color: rgb(245, 158, 11);
}

.btn-primary:hover {
    color: rgb(0, 0, 0);
    background-color: rgb(245, 158, 11);
    border-color: rgb(245, 158, 11);
}

/* Big solid call to action, e.g. "ENTER LEVEL 3: THE ARMORY" */
.btn-cta {
    height: 64px;
    font-size: 20px;
    color: rgb(42, 23, 0);
    background-color: rgb(255, 193, 116);
    border-color: rgb(255, 193, 116);
}

.btn-cta:hover {
    color: rgb(0, 0, 0);
    background-color: rgb(245, 158, 11);
    border-color: rgb(245, 158, 11);
}

.btn-danger {
    color: rgb(239, 68, 68);
    background-color: rgb(10, 10, 10);
    border-color: rgb(239, 68, 68);
}

.btn-danger:hover {
    color: rgb(0, 0, 0);
    background-color: rgb(239, 68, 68);
}

/* ---------- Chips (status tags) ---------- */

.chip {
    flex-direction: row;
    align-items: center;
    padding: 3px 9px;
    border-width: 1px;
    border-radius: 0;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    border-color: rgb(63, 63, 70);
    color: rgb(161, 161, 170);
    background-color: rgba(255, 255, 255, 0.03);
}

.chip Label {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
}

.chip--gold {
    border-color: rgba(245, 158, 11, 0.6);
    background-color: rgba(245, 158, 11, 0.1);
    color: rgb(245, 158, 11);
}

.chip--gold Label {
    color: rgb(245, 158, 11);
}

.chip--cyan {
    border-color: rgba(56, 189, 248, 0.6);
    background-color: rgba(56, 189, 248, 0.1);
    color: rgb(56, 189, 248);
}

.chip--cyan Label {
    color: rgb(56, 189, 248);
}

.chip--red {
    border-color: rgba(239, 68, 68, 0.7);
    background-color: rgba(239, 68, 68, 0.12);
    color: rgb(239, 68, 68);
}

.chip--red Label {
    color: rgb(239, 68, 68);
}

.chip--jade {
    border-color: rgba(16, 185, 129, 0.6);
    background-color: rgba(16, 185, 129, 0.1);
    color: rgb(16, 185, 129);
}

.chip--jade Label {
    color: rgb(16, 185, 129);
}

/* ---------- Cards ---------- */

.card {
    padding: 12px 14px;
    margin-bottom: 8px;
    background-color: rgb(10, 10, 10);
    border-width: 1px;
    border-color: rgb(31, 31, 31);
    border-radius: 0;
}

.card-title {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(56, 189, 248);
}

/* Weather card: cyan accent edge */
.weather-card {
    border-left-width: 2px;
    border-left-color: rgb(56, 189, 248);
}

.weather-temp {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(244, 244, 245);
    margin-right: 10px;
}

.weather-name {
    font-size: 20px;
    color: rgb(56, 189, 248);
}

.effect-title {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: rgb(56, 189, 248);
}

/* ---------- Dungeon hub (main menu) ---------- */

.hub {
    width: 94%;
    height: 92%;
    max-width: 1220px;
    flex-direction: row;
}

.hub-left {
    width: 38%;
    min-width: 400px;
    margin-right: 20px;
}

.hub-right {
    flex-grow: 1;
}

.hub-brand {
    margin-bottom: 14px;
}

.slot {
    width: 44px;
    height: 44px;
    margin-right: 8px;
    align-items: center;
    justify-content: center;
    background-color: rgb(18, 18, 18);
    border-width: 1px;
    border-color: rgb(39, 39, 42);
}

.slot--locked {
    opacity: 0.35;
}

.hub-hearts {
    flex-direction: row;
    margin: 8px 0 10px 0;
}

.hub-heart {
    width: 30px;
    height: 30px;
    margin-right: 6px;
    padding: 4px;
    background-color: rgb(18, 18, 18);
    border-width: 1px;
    border-color: rgb(39, 39, 42);
    -unity-background-scale-mode: scale-to-fit;
}

.stats {
    margin-top: 6px;
    font-size: 12px;
    letter-spacing: 1.5px;
    color: rgb(113, 113, 122);
}

/* Room cards on the chamber list */
.room-card {
    flex-direction: row;
    align-items: center;
    height: 78px;
    margin: 0 0 8px 0;
    padding: 0 14px;
    background-color: rgb(10, 10, 10);
    border-width: 1px;
    border-color: rgb(31, 31, 31);
    border-radius: 0;
}

.room-card:hover {
    border-color: rgb(56, 189, 248);
}

.room-card--available {
    border-color: rgb(245, 158, 11);
    background-color: rgb(18, 14, 6);
}

.room-card--locked {
    opacity: 0.4;
}

.room-status {
    width: 46px;
    height: 46px;
    margin-right: 14px;
    padding: 9px;
    background-color: rgb(18, 18, 18);
    border-width: 1px;
    border-color: rgb(39, 39, 42);
    -unity-background-scale-mode: scale-to-fit;
}

.room-card--available .room-status {
    background-color: rgb(255, 193, 116);
    border-color: rgb(255, 193, 116);
}

.room-number {
    font-size: 13px;
    letter-spacing: 1.5px;
    color: rgb(113, 113, 122);
    margin-right: 8px;
}

.room-name {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(244, 244, 245);
}

.room-card--available .room-name {
    color: rgb(255, 193, 116);
}

.room-hostiles {
    font-size: 13px;
    color: rgb(161, 161, 170);
}

/* ---------- HUD ---------- */

.hud {
    flex-grow: 1;
}

.hud-top-left {
    position: absolute;
    left: 24px;
    top: 20px;
    width: 560px;
}

.hud-top-right {
    position: absolute;
    right: 24px;
    top: 20px;
    width: 440px;
    align-items: flex-end;
}

.hud-box {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    margin-right: 8px;
    background-color: rgba(10, 10, 10, 0.92);
    border-width: 1px;
    border-color: rgb(31, 31, 31);
}

.hearts {
    flex-direction: row;
}

.heart {
    width: 26px;
    height: 26px;
    margin-right: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-mono {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: rgb(244, 244, 245);
}

.hud-mono--gold {
    color: rgb(255, 193, 116);
}

.objective-bar {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    padding: 10px 12px;
    background-color: rgba(10, 10, 10, 0.92);
    border-width: 1px;
    border-color: rgb(31, 31, 31);
}

.objective {
    flex-grow: 1;
    font-size: 17px;
    color: rgb(244, 244, 245);
    white-space: normal;
}

.weather-banner {
    width: 100%;
    padding: 10px 12px;
    background-color: rgba(10, 10, 10, 0.92);
    border-width: 1px;
    border-color: rgb(31, 31, 31);
    border-left-width: 2px;
    border-left-color: rgb(56, 189, 248);
}

.conditions {
    font-size: 14px;
    color: rgb(56, 189, 248);
    white-space: normal;
}

.inventory {
    flex-direction: row;
    margin-top: 8px;
}

.inventory-item {
    flex-direction: row;
    align-items: center;
    margin-left: 8px;
    padding: 6px 10px;
    background-color: rgba(10, 10, 10, 0.92);
    border-width: 1px;
    border-color: rgba(245, 158, 11, 0.5);
}

.inventory-icon {
    width: 22px;
    height: 22px;
    -unity-background-scale-mode: scale-to-fit;
}

.inventory-count {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 193, 116);
    margin-left: 6px;
}

.pause-button {
    width: 48px;
    height: 48px;
    margin-top: 8px;
    padding: 0;
    -unity-text-align: middle-center;
    font-size: 18px;
}

.abilities {
    position: absolute;
    bottom: 22px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}

.ability-slot {
    width: 76px;
    height: 76px;
    margin: 0 6px;
    background-color: rgba(10, 10, 10, 0.92);
    border-width: 1px;
    border-color: rgb(39, 39, 42);
    overflow: hidden;
}

.ability-slot--sword { border-color: rgba(239, 68, 68, 0.8); }
.ability-slot--dash { border-color: rgba(56, 189, 248, 0.8); }
.ability-slot--fireball { border-color: rgba(245, 158, 11, 0.8); }

.ability-icon {
    position: absolute;
    left: 14px;
    top: 10px;
    right: 14px;
    bottom: 22px;
    -unity-background-scale-mode: scale-to-fit;
}

.ability-name {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    -unity-text-align: middle-center;
    color: rgb(161, 161, 170);
}

.ability-cooldown {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    background-color: rgba(0, 0, 0, 0.75);
}

.ability-lock {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 20px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0.7);
}

.ability-key {
    position: absolute;
    top: 3px;
    right: 5px;
    font-size: 10px;
    letter-spacing: 1px;
    color: rgb(113, 113, 122);
}

.prompt {
    position: absolute;
    bottom: 112px;
    align-self: center;
    padding: 8px 16px;
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: rgb(244, 244, 245);
    background-color: rgba(10, 10, 10, 0.95);
    border-width: 1px;
    border-color: rgb(245, 158, 11);
}

/* ---------- Overlays ---------- */

.overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.82);
}

.overlay-panel {
    width: 60%;
    max-width: 620px;
}

.debrief-title {
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(244, 244, 245);
    white-space: normal;
    margin: 4px 0 6px 0;
}

.danger-title {
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(239, 68, 68);
}

/* Progress track: R1 to R5 */
.track {
    flex-direction: row;
    align-items: center;
    margin: 6px 0 4px 0;
}

.track-node {
    width: 40px;
    height: 40px;
    padding: 9px;
    background-color: rgb(18, 18, 18);
    border-width: 1px;
    border-color: rgb(39, 39, 42);
    -unity-background-scale-mode: scale-to-fit;
}

.track-node--current {
    background-color: rgb(245, 158, 11);
    border-color: rgb(245, 158, 11);
}

.track-line {
    flex-grow: 1;
    height: 2px;
    background-color: rgb(39, 39, 42);
}

.track-line--done {
    background-color: rgb(245, 158, 11);
}

.spoil {
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
    margin-bottom: 6px;
    background-color: rgb(10, 10, 10);
    border-width: 1px;
    border-color: rgb(31, 31, 31);
}

.spoil-icon {
    width: 40px;
    height: 40px;
    padding: 8px;
    margin-right: 12px;
    background-color: rgb(18, 18, 18);
    border-width: 1px;
    border-color: rgb(39, 39, 42);
    -unity-background-scale-mode: scale-to-fit;
}

.spoil-name {
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(255, 193, 116);
}

.loading-bar {
    height: 14px;
    margin: 16px 0;
    background-color: rgb(31, 31, 31);
    overflow: hidden;
}

.loading-fill {
    height: 100%;
    width: 0;
    background-color: rgb(245, 158, 11);
}

/* ---------- Touch controls ---------- */

.touch {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 270px;
}

.joystick {
    position: absolute;
    left: 40px;
    bottom: 40px;
    width: 190px;
    height: 190px;
    border-radius: 95px;
    background-color: rgba(18, 18, 18, 0.85);
    border-width: 1px;
    border-color: rgb(63, 63, 70);
    align-items: center;
    justify-content: center;
}

.joystick-knob {
    width: 74px;
    height: 74px;
    border-radius: 37px;
    background-color: rgba(245, 158, 11, 0.35);
    border-width: 1px;
    border-color: rgb(245, 158, 11);
}

.compass {
    position: absolute;
    font-size: 12px;
    color: rgb(113, 113, 122);
}

.touch-buttons {
    position: absolute;
    right: 30px;
    bottom: 30px;
    width: 250px;
    height: 230px;
}

.touch-button {
    position: absolute;
    width: 96px;
    height: 96px;
    border-radius: 48px;
    align-items: center;
    justify-content: center;
    background-color: rgba(18, 18, 18, 0.9);
    border-width: 1px;
    border-color: rgb(63, 63, 70);
}

.touch-button--strike {
    width: 120px;
    height: 120px;
    border-radius: 60px;
    background-color: rgb(245, 158, 11);
    border-color: rgb(245, 158, 11);
}

.touch-icon {
    width: 34px;
    height: 34px;
    -unity-background-scale-mode: scale-to-fit;
}

.touch-label {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: rgb(244, 244, 245);
}

.touch-button--strike .touch-label {
    color: rgb(42, 23, 0);
}
