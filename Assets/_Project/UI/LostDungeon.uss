/*
   Abyssal Crypt design system (from the Google Stitch designs in stitch_lost_dungeon_crawler).
   Void black surfaces, square corners, 1px razor borders, luminous accents:
   gold #f59e0b = loot and main actions, cyan #38bdf8 = weather and agility,
   red #ef4444 = health and danger, jade #10b981 = completion.
*/

/* ---------- Base ---------- */

.screen {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    background-color: rgb(0, 0, 0);
}

Label {
    color: rgb(244, 244, 245);
}

.panel {
    padding: 20px 22px;
    background-color: rgb(10, 10, 10);
    border-width: 1px;
    border-color: rgb(31, 31, 31);
    border-radius: 0;
}

.panel--raised {
    background-color: rgb(18, 18, 18);
}

.title {
    font-size: 40px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(244, 244, 245);
    white-space: normal;
}

.heading {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(244, 244, 245);
}

.eyebrow {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2.5px;
    color: rgb(245, 158, 11);
}

.mono {
    font-size: 13px;
    letter-spacing: 1.5px;
    color: rgb(113, 113, 122);
}

.body {
    font-size: 15px;
    color: rgb(212, 212, 216);
    white-space: normal;
}

.muted {
    color: rgb(113, 113, 122);
}

.row {
    flex-direction: row;
    align-items: center;
}

.spacer {
    flex-grow: 1;
}

.divider {
    height: 1px;
    margin: 12px 0;
    background-color: rgb(31, 31, 31);
}

.icon {
    width: 22px;
    height: 22px;
    -unity-background-scale-mode: scale-to-fit;
}

.icon--lg {
    width: 34px;
    height: 34px;
}

/* ---------- Buttons ---------- */

Button {
    height: 48px;
    margin: 5px 0;
    padding: 0 16px;
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-left;
    color: rgb(244, 244, 245);
    background-color: rgb(0, 0, 0);
    border-width: 1px;
    border-color: rgb(39, 39, 42);
    border-radius: 0;
    transition-duration: 0.08s;
}

Button:hover {
    border-color: rgb(56, 189, 248);
}

Button:active {
    background-color: rgb(18, 18, 18);
}

Button:disabled {
    opacity: 0.35;
}

.btn-primary {
    color: rgb(245, 158, 11);
    background-color: rgb(10, 10, 10);
    border-color: rgb(245, 158, 11);
}

.btn-primary:hover {
    color: rgb(0, 0, 0);
    background-color: rgb(245, 158, 11);
    border-color: rgb(245, 158, 11);
}

/* Big solid call to action, e.g. "ENTER LEVEL 3: THE ARMORY" */
.btn-cta {
    height: 64px;
    font-size: 20px;
    color: rgb(42, 23, 0);
    background-color: rgb(255, 193, 116);
    border-color: rgb(255, 193, 116);
}

.btn-cta:hover {
    color: rgb(0, 0, 0);
    background-color: rgb(245, 158, 11);
    border-color: rgb(245, 158, 11);
}

.btn-danger {
    color: rgb(239, 68, 68);
    background-color: rgb(10, 10, 10);
    border-color: rgb(239, 68, 68);
}

.btn-danger:hover {
    color: rgb(0, 0, 0);
    background-color: rgb(239, 68, 68);
}

/* ---------- Chips (status tags) ---------- */

.chip {
    flex-direction: row;
    align-items: center;
    padding: 3px 9px;
    border-width: 1px;
    border-radius: 0;
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    border-color: rgb(63, 63, 70);
    color: rgb(161, 161, 170);
    background-color: rgba(255, 255, 255, 0.03);
}

.chip Label {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
}

.chip--gold {
    border-color: rgba(245, 158, 11, 0.6);
    background-color: rgba(245, 158, 11, 0.1);
    color: rgb(245, 158, 11);
}

.chip--gold Label {
    color: rgb(245, 158, 11);
}

.chip--cyan {
    border-color: rgba(56, 189, 248, 0.6);
    background-color: rgba(56, 189, 248, 0.1);
    color: rgb(56, 189, 248);
}

.chip--cyan Label {
    color: rgb(56, 189, 248);
}

.chip--red {
    border-color: rgba(239, 68, 68, 0.7);
    background-color: rgba(239, 68, 68, 0.12);
    color: rgb(239, 68, 68);
}

.chip--red Label {
    color: rgb(239, 68, 68);
}

.chip--jade {
    border-color: rgba(16, 185, 129, 0.6);
    background-color: rgba(16, 185, 129, 0.1);
    color: rgb(16, 185, 129);
}

.chip--jade Label {
    color: rgb(16, 185, 129);
}

/* ---------- Cards ---------- */

.card {
    padding: 12px 14px;
    margin-bottom: 8px;
    background-color: rgb(10, 10, 10);
    border-width: 1px;
    border-color: rgb(31, 31, 31);
    border-radius: 0;
}

.card-title {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(56, 189, 248);
}

/* Weather card: cyan accent edge */
.weather-card {
    border-left-width: 2px;
    border-left-color: rgb(56, 189, 248);
}

.weather-temp {
    font-size: 30px;
    -unity-font-style: bold;
    color: rgb(244, 244, 245);
    margin-right: 10px;
}

.weather-name {
    font-size: 20px;
    color: rgb(56, 189, 248);
}

.effect-title {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: rgb(56, 189, 248);
}

/* ---------- Dungeon hub (main menu) ---------- */

.hub {
    width: 94%;
    height: 92%;
    max-width: 1220px;
    flex-direction: row;
}

.hub-left {
    width: 38%;
    min-width: 400px;
    margin-right: 20px;
}

.hub-right {
    flex-grow: 1;
}

.hub-brand {
    margin-bottom: 14px;
}

.slot {
    width: 44px;
    height: 44px;
    margin-right: 8px;
    align-items: center;
    justify-content: center;
    background-color: rgb(18, 18, 18);
    border-width: 1px;
    border-color: rgb(39, 39, 42);
}

.slot--locked {
    opacity: 0.35;
}

.hub-hearts {
    flex-direction: row;
    margin: 8px 0 10px 0;
}

.hub-heart {
    width: 30px;
    height: 30px;
    margin-right: 6px;
    padding: 4px;
    background-color: rgb(18, 18, 18);
    border-width: 1px;
    border-color: rgb(39, 39, 42);
    -unity-background-scale-mode: scale-to-fit;
}

.stats {
    margin-top: 6px;
    font-size: 12px;
    letter-spacing: 1.5px;
    color: rgb(113, 113, 122);
}

/* Room cards on the chamber list */
.room-card {
    flex-direction: row;
    align-items: center;
    height: 78px;
    margin: 0 0 8px 0;
    padding: 0 14px;
    background-color: rgb(10, 10, 10);
    border-width: 1px;
    border-color: rgb(31, 31, 31);
    border-radius: 0;
}

.room-card:hover {
    border-color: rgb(56, 189, 248);
}

.room-card--available {
    border-color: rgb(245, 158, 11);
    background-color: rgb(18, 14, 6);
}

.room-card--locked {
    opacity: 0.4;
}

.room-status {
    width: 46px;
    height: 46px;
    margin-right: 14px;
    padding: 9px;
    background-color: rgb(18, 18, 18);
    border-width: 1px;
    border-color: rgb(39, 39, 42);
    -unity-background-scale-mode: scale-to-fit;
}

.room-card--available .room-status {
    background-color: rgb(255, 193, 116);
    border-color: rgb(255, 193, 116);
}

.room-number {
    font-size: 13px;
    letter-spacing: 1.5px;
    color: rgb(113, 113, 122);
    margin-right: 8px;
}

.room-name {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(244, 244, 245);
}

.room-card--available .room-name {
    color: rgb(255, 193, 116);
}

.room-hostiles {
    font-size: 13px;
    color: rgb(161, 161, 170);
}

/* ---------- HUD ---------- */

.hud {
    flex-grow: 1;
}

.hud-top-left {
    position: absolute;
    left: 24px;
    top: 20px;
    width: 560px;
}

.hud-top-right {
    position: absolute;
    right: 24px;
    top: 20px;
    width: 440px;
    align-items: flex-end;
}

.hud-box {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    margin-right: 8px;
    background-color: rgba(10, 10, 10, 0.92);
    border-width: 1px;
    border-color: rgb(31, 31, 31);
}

.hearts {
    flex-direction: row;
}

.heart {
    width: 26px;
    height: 26px;
    margin-right: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-mono {
    font-size: 13px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: rgb(244, 244, 245);
}

.hud-mono--gold {
    color: rgb(255, 193, 116);
}

.objective-bar {
    flex-direction: row;
    align-items: center;
    margin-top: 8px;
    padding: 10px 12px;
    background-color: rgba(10, 10, 10, 0.92);
    border-width: 1px;
    border-color: rgb(31, 31, 31);
}

.objective {
    flex-grow: 1;
    font-size: 17px;
    color: rgb(244, 244, 245);
    white-space: normal;
}

.weather-banner {
    width: 100%;
    padding: 10px 12px;
    background-color: rgba(10, 10, 10, 0.92);
    border-width: 1px;
    border-color: rgb(31, 31, 31);
    border-left-width: 2px;
    border-left-color: rgb(56, 189, 248);
}

.conditions {
    font-size: 14px;
    color: rgb(56, 189, 248);
    white-space: normal;
}

.inventory {
    flex-direction: row;
    margin-top: 8px;
}

.inventory-item {
    flex-direction: row;
    align-items: center;
    margin-left: 8px;
    padding: 6px 10px;
    background-color: rgba(10, 10, 10, 0.92);
    border-width: 1px;
    border-color: rgba(245, 158, 11, 0.5);
}

.inventory-icon {
    width: 22px;
    height: 22px;
    -unity-background-scale-mode: scale-to-fit;
}

.inventory-count {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 193, 116);
    margin-left: 6px;
}

.pause-button {
    width: 48px;
    height: 48px;
    margin-top: 8px;
    padding: 0;
    -unity-text-align: middle-center;
    font-size: 18px;
}

.abilities {
    position: absolute;
    bottom: 22px;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
}

.ability-slot {
    width: 76px;
    height: 76px;
    margin: 0 6px;
    background-color: rgba(10, 10, 10, 0.92);
    border-width: 1px;
    border-color: rgb(39, 39, 42);
    overflow: hidden;
}

.ability-slot--sword { border-color: rgba(239, 68, 68, 0.8); }
.ability-slot--dash { border-color: rgba(56, 189, 248, 0.8); }
.ability-slot--fireball { border-color: rgba(245, 158, 11, 0.8); }

.ability-icon {
    position: absolute;
    left: 14px;
    top: 10px;
    right: 14px;
    bottom: 22px;
    -unity-background-scale-mode: scale-to-fit;
}

.ability-name {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    -unity-text-align: middle-center;
    color: rgb(161, 161, 170);
}

.ability-cooldown {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    background-color: rgba(0, 0, 0, 0.75);
}

.ability-lock {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 20px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0.7);
}

.ability-key {
    position: absolute;
    top: 3px;
    right: 5px;
    font-size: 10px;
    letter-spacing: 1px;
    color: rgb(113, 113, 122);
}

.prompt {
    position: absolute;
    bottom: 112px;
    align-self: center;
    padding: 8px 16px;
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: rgb(244, 244, 245);
    background-color: rgba(10, 10, 10, 0.95);
    border-width: 1px;
    border-color: rgb(245, 158, 11);
}

/* ---------- Overlays ---------- */

.overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.82);
}

.overlay-panel {
    width: 60%;
    max-width: 620px;
}

.debrief-title {
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(244, 244, 245);
    white-space: normal;
    margin: 4px 0 6px 0;
}

.danger-title {
    font-size: 34px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(239, 68, 68);
}

/* Progress track: R1 to R5 */
.track {
    flex-direction: row;
    align-items: center;
    margin: 6px 0 4px 0;
}

.track-node {
    width: 40px;
    height: 40px;
    padding: 9px;
    background-color: rgb(18, 18, 18);
    border-width: 1px;
    border-color: rgb(39, 39, 42);
    -unity-background-scale-mode: scale-to-fit;
}

.track-node--current {
    background-color: rgb(245, 158, 11);
    border-color: rgb(245, 158, 11);
}

.track-line {
    flex-grow: 1;
    height: 2px;
    background-color: rgb(39, 39, 42);
}

.track-line--done {
    background-color: rgb(245, 158, 11);
}

.spoil {
    flex-direction: row;
    align-items: center;
    padding: 10px 12px;
    margin-bottom: 6px;
    background-color: rgb(10, 10, 10);
    border-width: 1px;
    border-color: rgb(31, 31, 31);
}

.spoil-icon {
    width: 40px;
    height: 40px;
    padding: 8px;
    margin-right: 12px;
    background-color: rgb(18, 18, 18);
    border-width: 1px;
    border-color: rgb(39, 39, 42);
    -unity-background-scale-mode: scale-to-fit;
}

.spoil-name {
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(255, 193, 116);
}

.loading-bar {
    height: 14px;
    margin: 16px 0;
    background-color: rgb(31, 31, 31);
    overflow: hidden;
}

.loading-fill {
    height: 100%;
    width: 0;
    background-color: rgb(245, 158, 11);
}

/* ---------- Touch controls ---------- */

.touch {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 270px;
}

.joystick {
    position: absolute;
    left: 40px;
    bottom: 40px;
    width: 190px;
    height: 190px;
    border-radius: 95px;
    background-color: rgba(18, 18, 18, 0.85);
    border-width: 1px;
    border-color: rgb(63, 63, 70);
    align-items: center;
    justify-content: center;
}

.joystick-knob {
    width: 74px;
    height: 74px;
    border-radius: 37px;
    background-color: rgba(245, 158, 11, 0.35);
    border-width: 1px;
    border-color: rgb(245, 158, 11);
}

.compass {
    position: absolute;
    font-size: 12px;
    color: rgb(113, 113, 122);
}

.touch-buttons {
    position: absolute;
    right: 30px;
    bottom: 30px;
    width: 250px;
    height: 230px;
}

.touch-button {
    position: absolute;
    width: 96px;
    height: 96px;
    border-radius: 48px;
    align-items: center;
    justify-content: center;
    background-color: rgba(18, 18, 18, 0.9);
    border-width: 1px;
    border-color: rgb(63, 63, 70);
}

.touch-button--strike {
    width: 120px;
    height: 120px;
    border-radius: 60px;
    background-color: rgb(245, 158, 11);
    border-color: rgb(245, 158, 11);
}

.touch-icon {
    width: 34px;
    height: 34px;
    -unity-background-scale-mode: scale-to-fit;
}

.touch-label {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 1.5px;
    color: rgb(244, 244, 245);
}

.touch-button--strike .touch-label {
    color: rgb(42, 23, 0);
}

/* ---------- World-space overlay: enemy name plates and damage numbers ---------- */
.world-layer {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.nameplate {
    position: absolute;
    width: 150px;
    margin-left: -75px;
    margin-top: -30px;
    align-items: center;
}

.nameplate-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(255, 214, 170);
    letter-spacing: 1px;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
    padding: 0;
    margin: 0 0 2px 0;
}

.nameplate-bar {
    width: 96px;
    height: 7px;
    background-color: rgba(10, 4, 4, 0.85);
    border-width: 1px;
    border-color: rgba(239, 68, 68, 0.75);
}

.nameplate-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(239, 68, 68);
}

.damage-number {
    position: absolute;
    width: 160px;
    margin-left: -80px;
    margin-top: -16px;
    -unity-text-align: middle-center;
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(40, 14, 0);
    padding: 0;
}

.damage-number--crit {
    font-size: 32px;
    color: rgb(255, 196, 46);
    -unity-text-outline-color: rgb(120, 30, 0);
}

.damage-number--hurt {
    color: rgb(255, 92, 92);
    -unity-text-outline-color: rgb(60, 0, 0);
}

/* ======================================================================
   "Four Elements" HUD: gold-framed capsules, element orbs, round glowing
   ability buttons with cooldown rings, ring joystick.
   ====================================================================== */
.fe-hidden { display: none; }

.fe-top {
    position: absolute;
    left: 18px; right: 18px; top: 14px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.fe-capsule {
    background-color: rgba(8, 10, 9, 0.78);
    border-width: 2px;
    border-color: rgba(214, 168, 76, 0.85);
    border-radius: 18px;
    padding: 8px 14px;
}

.fe-vitality { width: 250px; }

.fe-orbs { flex-direction: row; margin-bottom: 8px; }

.fe-orb {
    width: 38px; height: 38px;
    border-radius: 19px;
    border-width: 3px;
    margin-right: 8px;
    align-items: center;
    justify-content: center;
    background-color: rgba(20, 22, 26, 0.9);
}
.fe-orb-icon { width: 20px; height: 20px; -unity-background-scale-mode: scale-to-fit; }
.fe-orb--gold { border-color: rgb(255, 196, 70); background-color: rgba(120, 80, 10, 0.55); }
.fe-orb--cyan { border-color: rgb(80, 220, 255); background-color: rgba(10, 80, 110, 0.55); }
.fe-orb--fire { border-color: rgb(255, 110, 50); background-color: rgba(120, 30, 10, 0.55); }
.fe-orb--jade { border-color: rgb(60, 220, 140); background-color: rgba(10, 90, 50, 0.55); }
.fe-orb--off { border-color: rgb(90, 50, 50); background-color: rgba(30, 20, 20, 0.85); opacity: 0.7; }

.fe-bar {
    height: 12px;
    border-radius: 6px;
    background-color: rgba(30, 30, 30, 0.95);
    border-width: 1px;
    border-color: rgba(214, 168, 76, 0.5);
    overflow: hidden;
    margin-bottom: 5px;
}
.fe-bar-fill {
    height: 100%;
    width: 100%;
    border-radius: 6px;
    background-color: rgb(232, 180, 60);
    border-right-width: 10px;
    border-right-color: rgb(80, 210, 230);
}

.fe-caption {
    font-size: 11px;
    color: rgb(220, 200, 160);
    letter-spacing: 2px;
    -unity-font-style: bold;
    padding: 0; margin: 0;
}
.fe-caption--gold { color: rgb(255, 196, 70); }
.fe-caption--cyan { color: rgb(110, 225, 255); }

.fe-room {
    align-items: center;
    padding: 8px 30px 10px 30px;
    min-width: 230px;
}
.fe-room-title {
    font-size: 15px;
    color: rgb(255, 205, 100);
    letter-spacing: 4px;
    -unity-font-style: bold;
    padding: 0; margin: 0;
}
.fe-room-count {
    font-size: 26px;
    color: rgb(255, 225, 150);
    -unity-font-style: bold;
    letter-spacing: 3px;
    padding: 0; margin: 0 0 2px 0;
}
.fe-dot {
    width: 10px; height: 10px;
    border-radius: 5px;
    margin-left: 4px;
    background-color: rgb(239, 68, 68);
    border-width: 1px;
    border-color: rgb(255, 160, 140);
}

.fe-right { align-items: flex-end; }
.fe-gold {
    flex-direction: row;
    align-items: center;
    padding: 6px 16px;
}
.fe-gold-count {
    font-size: 20px;
    color: rgb(255, 225, 150);
    -unity-font-style: bold;
    padding: 0; margin: 0 0 0 8px;
}
.fe-pause {
    width: 46px; height: 46px;
    margin: 0 0 0 10px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(255, 205, 100);
    background-color: rgb(214, 160, 50);
    color: rgb(40, 24, 0);
    font-size: 18px;
    -unity-font-style: bold;
}
.fe-pause:hover { background-color: rgb(240, 190, 80); }

.fe-weather {
    margin-top: 8px;
    max-width: 270px;
    border-color: rgba(80, 200, 240, 0.6);
    padding: 6px 12px;
}
.fe-weather-text {
    font-size: 11px;
    color: rgb(200, 225, 235);
    white-space: normal;
    padding: 0; margin: 3px 0 0 0;
}

.fe-banner {
    position: absolute;
    top: 128px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    padding: 8px 22px;
    background-color: rgba(18, 14, 6, 0.82);
    border-width: 2px;
    border-color: rgb(214, 168, 76);
    border-radius: 10px;
    max-width: 520px;
}
.fe-banner--open { border-color: rgb(60, 220, 140); background-color: rgba(6, 30, 18, 0.85); }
.fe-banner-text {
    font-size: 14px;
    color: rgb(255, 225, 160);
    letter-spacing: 2px;
    -unity-font-style: bold;
    padding: 0; margin: 0;
}
.fe-banner--open .fe-banner-text { color: rgb(150, 255, 200); }

/* Round ability buttons, bottom right */
.fe-abilities {
    position: absolute;
    right: 24px; bottom: 22px;
    width: 300px; height: 230px;
}
.fe-ability {
    position: absolute;
    border-width: 2px;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 12, 16, 0.85);
}
.fe-ability--strike {
    width: 120px; height: 120px; border-radius: 60px;
    right: 0; bottom: 0;
    background-color: rgba(120, 80, 10, 0.92);
    border-color: rgb(255, 210, 100);
}
.fe-ability--dash {
    width: 74px; height: 74px; border-radius: 37px;
    right: 132px; bottom: 10px;
    border-color: rgb(80, 220, 255);
    background-color: rgba(8, 50, 70, 0.9);
}
.fe-ability--fire {
    width: 74px; height: 74px; border-radius: 37px;
    right: 18px; bottom: 134px;
    border-color: rgb(255, 110, 50);
    background-color: rgba(90, 20, 8, 0.9);
}
.fe-ability--use {
    width: 66px; height: 66px; border-radius: 16px;
    right: 128px; bottom: 104px;
    border-color: rgb(60, 220, 140);
    background-color: rgba(8, 50, 30, 0.9);
    rotate: 8deg;
}
.fe-ability-icon { width: 46%; height: 46%; -unity-background-scale-mode: scale-to-fit; }
.fe-ability-name {
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(255, 235, 190);
    padding: 0; margin: 2px 0 0 0;
}
.fe-ability-time {
    position: absolute;
    top: 16%;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(0, 0, 0);
}
.fe-ability-key {
    position: absolute;
    top: -16px;
    font-size: 10px;
    color: rgb(200, 190, 160);
    padding: 0; margin: 0;
}
.fe-ability-lock {
    position: absolute;
    width: 50%; height: 50%;
    -unity-background-scale-mode: scale-to-fit;
}
.fe-ability--locked { opacity: 0.45; }

/* Ring joystick, bottom left (touch screens) */
.fe-joystick-area { position: absolute; left: 28px; bottom: 24px; }
.fe-joystick {
    width: 170px; height: 170px;
    border-radius: 85px;
    border-width: 3px;
    border-color: rgba(80, 220, 255, 0.85);
    background-color: rgba(6, 30, 44, 0.55);
    align-items: center;
    justify-content: center;
}
.fe-arrow {
    position: absolute;
    -unity-text-align: middle-center;
    font-size: 12px;
    color: rgba(130, 230, 255, 0.85);
    padding: 0; margin: 0;
}
.fe-knob {
    width: 70px; height: 70px;
    border-radius: 35px;
    border-width: 3px;
    border-color: rgb(140, 235, 255);
    background-color: rgba(30, 140, 190, 0.9);
}

/* ======================================================================
   Temple theme for the menus (matches the in-game "Four Elements" HUD).
   Later rules override the earlier Abyssal ones. The 3D temple scene
   renders behind these panels, so surfaces are translucent.
   ====================================================================== */
.screen {
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
}

.hub {
    width: 96%;
    height: 92%;
    max-width: 1500px;
    justify-content: space-between;
}

.hub-left {
    width: 31%;
    min-width: 330px;
    margin-right: 0;
}

.hub-right {
    flex-grow: 0;
    width: 41%;
    min-width: 420px;
}

.panel, .card {
    background-color: rgba(10, 12, 10, 0.8);
    border-width: 2px;
    border-color: rgba(214, 168, 76, 0.7);
    border-radius: 18px;
}

.panel--raised {
    background-color: rgba(40, 32, 16, 0.6);
    border-width: 1px;
    border-color: rgba(214, 168, 76, 0.35);
    border-radius: 12px;
}

.weather-card {
    border-color: rgba(80, 200, 240, 0.7);
    border-left-width: 2px;
    border-left-color: rgba(80, 200, 240, 0.7);
}

.title {
    font-size: 44px;
    color: rgb(255, 224, 150);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgb(120, 60, 0);
}

.eyebrow { color: rgb(255, 190, 80); }
.heading { color: rgb(255, 224, 150); }

Button {
    border-radius: 14px;
    border-width: 2px;
    border-color: rgba(214, 168, 76, 0.45);
    background-color: rgba(14, 14, 12, 0.85);
    -unity-text-align: middle-center;
    color: rgb(255, 235, 200);
}

Button:hover {
    border-color: rgb(255, 210, 110);
    background-color: rgba(70, 52, 16, 0.92);
}

.btn-primary {
    color: rgb(40, 24, 0);
    background-color: rgb(214, 160, 50);
    border-color: rgb(255, 215, 120);
}

.btn-primary:hover {
    color: rgb(30, 16, 0);
    background-color: rgb(245, 195, 85);
    border-color: rgb(255, 235, 170);
}

.btn-cta {
    border-radius: 16px;
    color: rgb(40, 22, 0);
    background-color: rgb(240, 186, 66);
    border-color: rgb(255, 230, 150);
}

.btn-cta:hover {
    background-color: rgb(255, 205, 95);
    border-color: rgb(255, 245, 200);
}

.btn-danger {
    border-color: rgba(239, 68, 68, 0.8);
    background-color: rgba(40, 8, 8, 0.85);
}

.chip { border-radius: 10px; }

.slot, .hub-heart {
    border-radius: 10px;
    border-color: rgba(214, 168, 76, 0.4);
    background-color: rgba(30, 24, 12, 0.8);
}

.room-card {
    border-radius: 14px;
    border-width: 2px;
    background-color: rgba(12, 12, 10, 0.78);
    border-color: rgba(214, 168, 76, 0.25);
}

.room-card:hover { border-color: rgb(255, 210, 110); }

.room-card--available {
    background-color: rgba(70, 50, 10, 0.8);
    border-color: rgb(255, 205, 100);
}

.room-status {
    border-radius: 23px;
    border-color: rgba(214, 168, 76, 0.4);
    background-color: rgba(30, 24, 12, 0.9);
}

.room-card--available .room-status {
    background-color: rgb(240, 186, 66);
    border-color: rgb(255, 230, 150);
}

.room-card--available .room-name { color: rgb(255, 214, 120); }

.overlay { background-color: rgba(0, 0, 0, 0.62); }

.stats { color: rgb(200, 185, 150); }

/* Red glow around the screen edges when the hero is hurt */
.hurt-flash {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    border-width: 28px;
    border-color: rgba(220, 30, 20, 0.55);
    background-color: rgba(180, 0, 0, 0.12);
}

/* Pouch strip under the vitality bar: one slot per carried item */
.fe-pouch-row { margin-top: 6px; align-items: center; }
.fe-inventory { flex-direction: row; }
.fe-slot {
    flex-direction: row;
    align-items: center;
    height: 26px;
    padding: 0 8px 0 4px;
    margin-right: 6px;
    border-radius: 13px;
    border-width: 1px;
    border-color: rgba(214, 168, 76, 0.7);
    background-color: rgba(40, 30, 10, 0.85);
}
.fe-slot--key { border-color: rgb(60, 220, 140); background-color: rgba(8, 50, 30, 0.85); }
.fe-slot--potion { border-color: rgb(120, 230, 150); background-color: rgba(10, 40, 20, 0.85); }
.fe-slot-icon { width: 18px; height: 18px; margin-right: 4px; -unity-background-scale-mode: scale-to-fit; }
.fe-slot-count { font-size: 13px; -unity-font-style: bold; color: rgb(255, 230, 170); padding: 0; margin: 0; }

/* Level complete: one compact, centred card */
.overlay { background-color: rgba(0, 0, 0, 0.8); }

.debrief {
    width: 46%;
    min-width: 420px;
    max-width: 560px;
    align-items: stretch;
    padding: 24px 30px;
}
.debrief-center { -unity-text-align: middle-center; }
.debrief .debrief-title {
    font-size: 38px;
    color: rgb(255, 224, 150);
    margin: 6px 0 10px 0;
}
.debrief-reward {
    align-self: center;
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgb(150, 255, 200);
    padding: 6px 16px;
    margin-bottom: 14px;
    border-radius: 14px;
    border-width: 1px;
    border-color: rgb(60, 220, 140);
    background-color: rgba(8, 50, 30, 0.85);
}
.debrief-spoils {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 16px;
}
.spoil-chip {
    flex-direction: row;
    align-items: center;
    padding: 6px 14px 6px 8px;
    margin: 0 5px;
    border-radius: 18px;
    border-width: 1px;
    border-color: rgba(214, 168, 76, 0.7);
    background-color: rgba(40, 30, 10, 0.85);
}
.spoil-chip-icon { width: 24px; height: 24px; margin-right: 6px; -unity-background-scale-mode: scale-to-fit; }
.spoil-chip-text { font-size: 18px; -unity-font-style: bold; color: rgb(255, 230, 170); padding: 0; margin: 0; }
.debrief-track { align-self: center; margin: 0 0 6px 0; }
.debrief-progress {
    font-size: 12px;
    letter-spacing: 2px;
    color: rgb(200, 185, 150);
    margin-bottom: 14px;
}
