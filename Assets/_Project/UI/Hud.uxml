<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="LostDungeon.uss" />
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">

        <!-- Top bar, after the "Four Elements" mobile HUD design -->
        <ui:VisualElement class="fe-top" picking-mode="Ignore">

            <!-- Left: element orbs and the vitality bar -->
            <ui:VisualElement class="fe-capsule fe-vitality" picking-mode="Ignore">
                <ui:VisualElement class="fe-orbs" picking-mode="Ignore">
                    <ui:VisualElement name="orb-strike" class="fe-orb fe-orb--gold" picking-mode="Ignore"><ui:VisualElement name="orb-strike-icon" class="fe-orb-icon" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement name="orb-wind" class="fe-orb fe-orb--cyan" picking-mode="Ignore"><ui:VisualElement name="orb-wind-icon" class="fe-orb-icon" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement name="orb-fire" class="fe-orb fe-orb--fire" picking-mode="Ignore"><ui:VisualElement name="orb-fire-icon" class="fe-orb-icon" picking-mode="Ignore" /></ui:VisualElement>
                    <ui:VisualElement name="key-box" class="fe-orb fe-orb--jade" picking-mode="Ignore"><ui:VisualElement name="key-icon" class="fe-orb-icon" picking-mode="Ignore" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="fe-bar" picking-mode="Ignore">
                    <ui:VisualElement name="vitality-fill" class="fe-bar-fill" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="row" picking-mode="Ignore">
                    <ui:Label text="VITALITY" class="fe-caption" picking-mode="Ignore" />
                    <ui:Label name="hearts-bonus" text="+2" class="fe-caption fe-caption--gold" style="margin-left: 6px;" picking-mode="Ignore" />
                    <ui:VisualElement class="spacer" picking-mode="Ignore" />
                    <ui:Label name="vitality-text" text="6/6" class="fe-caption" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:Label name="key-label" text="" class="fe-hidden" picking-mode="Ignore" />
                <ui:VisualElement class="row fe-pouch-row" picking-mode="Ignore">
                    <ui:Label text="POUCH" class="fe-caption" style="margin-right: 8px;" picking-mode="Ignore" />
                    <ui:VisualElement name="inventory" class="fe-inventory" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Centre: room counter and enemies remaining -->
            <ui:VisualElement class="fe-capsule fe-room" picking-mode="Ignore">
                <ui:Label name="level-name" text="THE ENTRANCE" class="fe-room-title" picking-mode="Ignore" />
                <ui:Label name="room-count" text="1 / 5" class="fe-room-count" picking-mode="Ignore" />
                <ui:VisualElement class="row" style="justify-content: center;" picking-mode="Ignore">
                    <ui:Label name="foes" text="2 REMAIN:" class="fe-caption" picking-mode="Ignore" />
                    <ui:VisualElement name="foe-dots" class="row" style="margin-left: 6px;" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Right: gold, pause, live weather -->
            <ui:VisualElement class="fe-right" picking-mode="Ignore">
                <ui:VisualElement class="row" picking-mode="Ignore">
                    <ui:VisualElement class="fe-capsule fe-gold" picking-mode="Ignore">
                        <ui:VisualElement name="gold-icon" class="icon" picking-mode="Ignore" />
                        <ui:Label name="gold-count" text="0" class="fe-gold-count" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Button name="pause-button" text="II" class="fe-pause" />
                </ui:VisualElement>
                <ui:VisualElement class="fe-capsule fe-weather" picking-mode="Ignore">
                    <ui:VisualElement class="row" picking-mode="Ignore">
                        <ui:VisualElement name="weather-icon" class="icon" style="margin-right: 6px;" picking-mode="Ignore" />
                        <ui:Label name="weather-title" text="KIGALI WEATHER" class="fe-caption fe-caption--cyan" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="conditions" class="fe-weather-text" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Objective banner -->
        <ui:VisualElement name="objective-banner" class="fe-banner" picking-mode="Ignore">
            <ui:VisualElement name="objective-icon" class="icon" style="margin-right: 10px;" picking-mode="Ignore" />
            <ui:Label name="objective" class="fe-banner-text" picking-mode="Ignore" />
        </ui:VisualElement>

        <ui:Label name="prompt" class="prompt" picking-mode="Ignore" />

        <!-- Controls: ring joystick (touch screens) and round ability buttons with cooldown rings -->
        <ui:VisualElement name="touch" class="fe-joystick-area" picking-mode="Ignore">
            <ui:VisualElement name="joystick" class="fe-joystick">
                <ui:VisualElement name="joystick-knob" class="fe-knob" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="abilities" class="fe-abilities" picking-mode="Ignore" />
        <!-- Pause -->
        <ui:VisualElement name="pause-overlay" class="overlay">
            <ui:VisualElement class="panel overlay-panel">
                <ui:Label text="EXPEDITION HALTED" class="eyebrow" />
                <ui:Label text="PAUSED" class="title" style="margin-bottom: 14px;" />
                <ui:Button name="resume" text="RESUME" class="btn-primary" />
                <ui:Button name="pause-restart" text="RESTART LEVEL" />
                <ui:Button name="pause-menu" text="MAIN MENU" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Level complete: a short, focused debrief -->
        <ui:VisualElement name="complete-overlay" class="overlay">
            <ui:VisualElement class="panel debrief">
                <ui:Label text="EXPEDITION DEBRIEF" class="eyebrow debrief-center" />
                <ui:Label name="complete-title" text="ROOM 1 CLEARED" class="debrief-title debrief-center" />
                <ui:Label name="complete-reward" class="debrief-reward" />
                <ui:VisualElement name="spoils" class="debrief-spoils" />
                <ui:VisualElement name="track" class="track debrief-track" />
                <ui:Label name="progress-pct" text="1 OF 5 ROOMS CLEARED" class="debrief-progress debrief-center" />
                <ui:Button name="next-level" text="NEXT ROOM  >" class="btn-cta" />
                <ui:Button name="complete-menu" text="MAIN MENU" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Game over -->
        <ui:VisualElement name="gameover-overlay" class="overlay">
            <ui:VisualElement class="panel overlay-panel" style="border-color: rgba(239, 68, 68, 0.6);">
                <ui:Label text="EXPEDITION FAILED" class="eyebrow" style="color: rgb(239, 68, 68);" />
                <ui:Label text="VITALITY DEPLETED" class="danger-title" />
                <ui:Label name="gameover-text" text="You fell in the dungeon." class="body" style="margin: 6px 0 16px 0;" />
                <ui:Button name="retry" text="TRY AGAIN" class="btn-danger" />
                <ui:Button name="gameover-menu" text="MAIN MENU" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Loading -->
        <ui:VisualElement name="loading-overlay" class="overlay">
            <ui:VisualElement class="panel overlay-panel">
                <ui:Label text="DESCENDING" class="eyebrow" />
                <ui:Label name="loading-title" text="ENTERING ROOM 1" class="title" />
                <ui:VisualElement class="loading-bar">
                    <ui:VisualElement name="loading-fill" class="loading-fill" />
                </ui:VisualElement>
                <ui:Label name="loading-message" text="Loading chamber from Addressables..." class="mono" />
                <ui:Button name="loading-back" text="BACK TO MENU" style="margin-top: 12px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
